node_modules/
.env
*.env.*
*.key
*.pem

# 1. 로그 및 런타임 추적 파일 완전 차단 (개인정보 및 IP 유출 방지)
logs/
*.log
*.log.*
*.log.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 2. 사용자 업로드 사진 & 실시간 생성 모자이크 & 가이드 예시 사진 (초상권/개인정보 100% 보호)
public/outputs/*
!public/outputs/.gitkeep
public/output_guides/*
!public/output_guides/.gitkeep
public/raw_tiles/*
!public/raw_tiles/.gitkeep
public/guides/*
!public/guides/.gitkeep

# 3. 개인 사진 테마 제외 (유출 방지)
public/tiles/*/
!public/tiles/default_nasa/
data/themes/*/
!data/themes/default_nasa/

# 4. Blender 작업물 & 렌더링된 비디오 파일 (대용량/개인정보)
__pycache__/
*.pyc
*.pyo
*.blend1
*.blend@
blender_workspace/__pycache__/
blender_workspace/scenes/
blender_workspace/master_mosaic.jpg
blender_workspace/*.mp4
blender_workspace/*.blend1
*.mp4
*.mov
*.avi
*.webm

# 5. 과거 레거시 데이터 및 스크립트 제외 (NASA API키, 개인 사진 유출 방지)
old/
data/apod_originals/
data/tileDB.json

# 6. 대용량 바이너리 및 OS 임시 파일
cloudflared.exe
node-*.msi
dist/
*.zip
*.msi
*.tar.gz
.DS_Store
Thumbs.db
